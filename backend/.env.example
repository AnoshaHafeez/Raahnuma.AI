# ---------------------------------------------------------------------------
# Raahnuma.AI backend configuration
#
# Copy this file to `.env` in the same directory (backend/.env) and fill in the
# blanks. Every key below maps to a field on `Settings` in app/core/config.py
# (matching is case-insensitive). Anything left out falls back to the default
# shown in that file, so a bare-minimum local setup only needs DATABASE_URL and
# JWT_SECRET_KEY.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# development | staging | production
# In production the app refuses to boot with a default/short JWT_SECRET_KEY,
# and the /docs and /redoc pages are disabled.
ENVIRONMENT=development

# --- Database ----------------------------------------------------------------
# Must use the asyncpg driver — the app uses SQLAlchemy's async engine.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
#
# The credentials below match the `db` service in docker-compose.yml
# (POSTGRES_USER=user, POSTGRES_PASSWORD=password, POSTGRES_DB=raahnuma).
# Use `localhost` when uvicorn runs on your machine and only Postgres is in
# Docker. If you run the `api` service inside Compose too, the host must be the
# service name instead:
#   postgresql+asyncpg://user:password@db:5432/raahnuma
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/raahnuma

# --- Redis -------------------------------------------------------------------
# Used for rate limiting and for caching weather/advisory responses.
# Optional in development: if Redis is unreachable the app fails open (requests
# are allowed through and caching is skipped) rather than erroring.
# Inside Docker Compose this becomes redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- CORS --------------------------------------------------------------------
# Comma-separated list of exact frontend origins allowed to call this API.
# Include the port, and no trailing slash.
#
# Kept as an explicit allowlist rather than "*" so only your own frontend can
# make browser-initiated calls. The API authenticates with the Authorization
# header (not cookies), so CORS credentials are disabled in main.py.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true ONLY when running behind a reverse proxy that overwrites
# X-Forwarded-For (nginx, Cloudflare, a cloud load balancer). If this is true
# without such a proxy, clients can spoof the header to bypass rate limits.
TRUST_PROXY_HEADERS=false

# --- JWT ---------------------------------------------------------------------
# REQUIRED. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every issued token.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Groq (primary LLM for safety advisories) --------------------------------
# Get a key at https://console.groq.com/keys
# If both this and GEMINI_API_KEY are empty, trips are still created but their
# advisory stays empty — nothing crashes.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini (fallback LLM, used when Groq fails) -----------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Routing / Geocoding -----------------------------------------------------
# Public demo servers; no key needed. The OSRM demo server is rate limited and
# not for production use — self-host for real traffic.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real contact address here.
NOMINATIM_USER_AGENT=RaahnumaAI/1.0 (your-contact@example.com)

# --- Translation (Urdu advisories) -------------------------------------------
# The public libretranslate.com instance requires a key. Leave the key blank to
# skip translation; advisories then stay English-only.
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# --- Rate limiting & caching -------------------------------------------------
# Requests per minute, per client IP.
RATE_LIMIT_PER_MINUTE=30
# Tighter budget for /auth/login and /auth/register to slow credential stuffing.
AUTH_RATE_LIMIT_PER_MINUTE=10
# How long weather and advisory responses stay cached, in seconds.
WEATHER_CACHE_TTL_SECONDS=3600
ADVISORY_CACHE_TTL_SECONDS=3600

# --- Weather -----------------------------------------------------------------
# Open-Meteo is used for forecasts and needs no API key or configuration.
