# ---------------------------------------------------------------------------
# Raahnuma.AI frontend configuration
#
# Copy this file to `.env.local` in the same directory (frontend/.env.local).
# `.env.local` is gitignored; this example file is not.
#
# Only NEXT_PUBLIC_* variables are readable in browser code. Anything you put
# here WILL be inlined into the JavaScript bundle and is publicly visible, so
# never place secrets or API keys in this file — all third-party keys
# (Groq, Gemini, LibreTranslate) belong in backend/.env instead.
#
# Next.js reads env files at build/start time. Restart `npm run dev` after
# changing anything here.
# ---------------------------------------------------------------------------

# Origin of the FastAPI server — scheme + host + port, no trailing slash and no
# path. The client appends the `/api/v1` prefix itself (see src/lib/api.ts), so
# this must NOT include it.
#
#   Correct:   http://localhost:8000
#   Incorrect: http://localhost:8000/        (trailing slash)
#   Incorrect: http://localhost:8000/api/v1  (prefix is added automatically)
#
# Defaults to http://localhost:8000 when unset, which is the standard local
# uvicorn address — so for a plain local setup you can leave this as-is.
#
# Whatever value you use here must also appear in the backend's CORS_ORIGINS
# list, otherwise the browser will block every request.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
